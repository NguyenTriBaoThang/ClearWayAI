# ClearWayAI - Web Frontend Environment Template
# Copy this file to apps/web/.env

# API Gateway Endpoints
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Application Branding
VITE_APP_TITLE=ClearWay AI
VITE_APP_SUBTITLE=Emergency Traffic Pre-clearance & Digital Twin

# Operational Feature Flags
VITE_DEMO_MODE=true
VITE_ENABLE_3D_CANVAS=true
VITE_ENABLE_V2X_TELEMETRY=true
VITE_ENABLE_INSPECTOR_DRAWER=true

# Three.js Performance & Debugging Settings
VITE_MAX_FPS=60
VITE_DEBUG_STATS=false

