# ClearWayAI - Backend API Environment Template
# Copy this file to .env inside apps/api/ or set in system environment

# Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=info

# Operational Safety Modes: SIMULATION | OFFLINE_VIDEO | SHADOW_ADVISORY | AUTHORIZED_PILOT
# Invariant: Must remain SIMULATION for all development and testing environments.
SAFETY_MODE=SIMULATION
SIMULATION_ONLY=true

# Data Source & Provenance: DEMO_FIXTURE | SUMO_SIMULATED | LIVE_STREAM
DATA_PROVENANCE=DEMO_FIXTURE
DEMO_MODE=true

# Server Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Database URL
DATABASE_URL=sqlite:///./clearway.db

# SUMO Simulation Settings (Phase C+)
SUMO_HOME=
SUMO_GUI=false
SUMO_STEP_LENGTH=0.1

# AI Inference Settings (Phase E+)
DEVICE=cpu
MODEL_REGISTRY_PATH=../../models
CLEARANCE_MODEL_TYPE=xgboost

