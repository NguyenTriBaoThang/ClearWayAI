# ClearWayAI Configuration
# Copy this file to .env and adjust as necessary

# System Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Operational Safety Modes: SIMULATION | OFFLINE_VIDEO | SHADOW_ADVISORY | AUTHORIZED_PILOT
# STRICT SAFETY NOTICE: Default is SIMULATION. No real public road signal control is permitted.
SAFETY_MODE=SIMULATION
SIMULATION_ONLY=true

# Data Source & Demo Controls: DEMO_FIXTURE | SUMO_SIMULATED | LIVE_STREAM
DATA_PROVENANCE=DEMO_FIXTURE
DEMO_MODE=true

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Web Frontend Settings
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_APP_TITLE=ClearWay AI
VITE_DEMO_MODE=true

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./clearway.db

# SUMO Simulation Settings (for Task 23+)
SUMO_HOME=
SUMO_GUI=false
SUMO_STEP_LENGTH=0.1

# AI Model Inference Settings
DEVICE=cpu
MODEL_REGISTRY_PATH=./models
CLEARANCE_MODEL_TYPE=xgboost
