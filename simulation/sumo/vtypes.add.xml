<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">
    <!-- ClearWayAI Vietnamese Mixed Traffic Vehicle Types (ADR-0005) -->
    
    <!-- 1. Motorcycle (75% volume): Lateral sublane filtering, stopline swarming -->
    <vType id="motorcycle"
           vClass="motorcycle"
           length="1.90"
           width="0.70"
           height="1.20"
           minGap="0.40"
           maxSpeed="13.89"
           accel="3.2"
           decel="4.5"
           emergencyDecel="7.0"
           sigma="0.5"
           tau="0.8"
           laneChangeModel="SL2015"
           latAlignment="arbitrary"
           minGapLat="0.20"
           lcPushy="0.8"
           lcAssertive="0.9"
           lcSublane="1.0"
           lcKeepRight="0.0"
           guiShape="motorcycle"
           color="1.0,0.8,0.0"/>

    <!-- 2. Passenger Car (15% volume): Standard sedan/hatchback -->
    <vType id="car"
           vClass="passenger"
           length="4.60"
           width="1.90"
           height="1.50"
           minGap="1.50"
           maxSpeed="16.67"
           accel="2.6"
           decel="4.5"
           emergencyDecel="6.5"
           sigma="0.4"
           tau="1.0"
           laneChangeModel="SL2015"
           latAlignment="center"
           minGapLat="0.50"
           lcPushy="0.2"
           lcAssertive="0.4"
           lcSublane="0.5"
           guiShape="passenger"
           color="0.2,0.6,1.0"/>

    <!-- 3. SUV / Crossover (5% volume): Larger passenger automobile -->
    <vType id="suv"
           vClass="passenger"
           length="4.90"
           width="2.00"
           height="1.70"
           minGap="1.60"
           maxSpeed="16.67"
           accel="2.4"
           decel="4.5"
           emergencyDecel="6.5"
           sigma="0.4"
           tau="1.1"
           laneChangeModel="SL2015"
           latAlignment="center"
           minGapLat="0.50"
           lcPushy="0.2"
           lcAssertive="0.4"
           lcSublane="0.5"
           guiShape="passenger/wagon"
           color="0.3,0.8,0.4"/>

    <!-- 4. Urban Transit Bus (3% volume): Long public transit vehicle -->
    <vType id="bus"
           vClass="bus"
           length="11.00"
           width="2.50"
           height="3.20"
           minGap="2.00"
           maxSpeed="13.89"
           accel="1.8"
           decel="3.5"
           emergencyDecel="5.5"
           sigma="0.3"
           tau="1.4"
           laneChangeModel="SL2015"
           latAlignment="center"
           minGapLat="0.60"
           lcPushy="0.1"
           lcAssertive="0.2"
           lcSublane="0.2"
           guiShape="bus"
           color="0.9,0.3,0.3"/>

    <!-- 5. Commercial Delivery Truck (2% volume): Heavy goods transport -->
    <vType id="truck"
           vClass="truck"
           length="8.50"
           width="2.50"
           height="3.00"
           minGap="2.50"
           maxSpeed="12.50"
           accel="1.5"
           decel="3.0"
           emergencyDecel="5.0"
           sigma="0.3"
           tau="1.5"
           laneChangeModel="SL2015"
           latAlignment="center"
           minGapLat="0.60"
           lcPushy="0.1"
           lcAssertive="0.2"
           lcSublane="0.2"
           guiShape="truck"
           color="0.6,0.6,0.6"/>
</additional>

